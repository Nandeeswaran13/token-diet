{
  "name": "token-bakery",
  "version": "0.1.0",
  "description": "Diet the prompt in the box — before it hits the API. Local, zero-dependency, no LLM: live highlights, token counts, JSON minify, and secret/PII flags for any textarea.",
  "license": "MIT",
  "author": "Nandeeswaran",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "prepack": "bun run build",
    "prepublishOnly": "bun test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "tokens",
    "prompt",
    "compression",
    "minify",
    "openai",
    "token-saver",
    "headless",
    "prompt-watcher",
    "hygiene"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5"
  }
}
